{
  "Comment": "Checkout saga: hold seat -> create order -> charge -> confirm -> enqueue issuance -> notify. Compensation is a seat release before money moves and a refund (then release) after. JSONata query language.",
  "QueryLanguage": "JSONata",
  "StartAt": "HoldSeat",
  "States": {

    "HoldSeat": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "ApiEndpoint": "{% $states.input.inventoryBaseUrl & '/events/' & $states.input.eventId & '/seats/' & $states.input.seatId & '/hold' %}",
        "Method": "POST",
        "Authentication": { "ConnectionArn": "__CONNECTION_ARN__" }
      },
      "Assign": {
        "req": "{% $states.input %}",
        "holdId": "{% $states.result.ResponseBody.holdId %}"
      },
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "SeatUnavailable" }],
      "Next": "CreateOrder"
    },

    "CreateOrder": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "ApiEndpoint": "{% $req.checkoutBaseUrl & '/orders' %}",
        "Method": "POST",
        "Authentication": { "ConnectionArn": "__CONNECTION_ARN__" },
        "Headers": { "Content-Type": "application/json" },
        "RequestBody": {
          "orderId": "{% $req.orderId %}",
          "eventId": "{% $req.eventId %}",
          "customerRef": "{% $req.customerRef %}",
          "amountCents": "{% $req.amountCents %}",
          "idempotencyKey": "{% $req.orderKey %}",
          "seats": "{% [ { 'seatId': $req.seatId, 'holdId': $holdId } ] %}"
        }
      },
      "Assign": { "orderId": "{% $states.result.ResponseBody.id %}" },
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "ReleaseSeat" }],
      "Next": "ChargePayment"
    },

    "ChargePayment": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "ApiEndpoint": "{% $req.checkoutBaseUrl & '/orders/' & $orderId & '/payment' %}",
        "Method": "POST",
        "Authentication": { "ConnectionArn": "__CONNECTION_ARN__" },
        "Headers": { "Content-Type": "application/json" },
        "RequestBody": {
          "idempotencyKey": "{% $req.paymentKey %}",
          "paymentToken": "{% $req.paymentToken %}"
        }
      },
      "Assign": { "payment": "{% $states.result.ResponseBody %}" },
      "Retry": [{
        "ErrorEquals": ["States.ALL"],
        "IntervalSeconds": 2,
        "MaxAttempts": 3,
        "BackoffRate": 2.0
      }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "ReleaseSeat" }],
      "Next": "PaymentCaptured"
    },

    "PaymentCaptured": {
      "Type": "Choice",
      "Choices": [{
        "Condition": "{% $payment.paymentStatus = 'CAPTURED' %}",
        "Next": "ConfirmPurchase"
      }],
      "Default": "ReleaseSeat"
    },

    "ConfirmPurchase": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "ApiEndpoint": "{% $req.inventoryBaseUrl & '/events/' & $req.eventId & '/seats/' & $req.seatId & '/purchase' %}",
        "Method": "POST",
        "Authentication": { "ConnectionArn": "__CONNECTION_ARN__" },
        "Headers": { "Content-Type": "application/json" },
        "RequestBody": { "holdId": "{% $holdId %}" }
      },
      "Retry": [
        { "ErrorEquals": ["States.Http.StatusCode.404"], "MaxAttempts": 0 },
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        { "ErrorEquals": ["States.Http.StatusCode.404"], "Next": "RefundPayment" },
        { "ErrorEquals": ["States.ALL"], "Next": "PaidButNotConfirmed" }
      ],
      "Next": "EnqueueTicketIssuance"
    },

    "RefundPayment": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "ApiEndpoint": "{% $req.checkoutBaseUrl & '/orders/' & $orderId & '/refund' %}",
        "Method": "POST",
        "Authentication": { "ConnectionArn": "__CONNECTION_ARN__" },
        "Headers": { "Content-Type": "application/json" },
        "RequestBody": {
          "idempotencyKey": "{% $req.paymentKey & ':refund' %}",
          "reason": "seat_not_confirmed"
        }
      },
      "Assign": { "refund": "{% $states.result.ResponseBody %}" },
      "Retry": [{
        "ErrorEquals": ["States.ALL"],
        "IntervalSeconds": 2,
        "MaxAttempts": 4,
        "BackoffRate": 2.0
      }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "RefundFailed" }],
      "Next": "RefundSucceeded"
    },

    "RefundSucceeded": {
      "Type": "Choice",
      "Choices": [{
        "Condition": "{% $refund.refundStatus = 'SUCCEEDED' %}",
        "Next": "ReleaseSeatAfterRefund"
      }],
      "Default": "RefundFailed"
    },

    "ReleaseSeatAfterRefund": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "ApiEndpoint": "{% $req.inventoryBaseUrl & '/events/' & $req.eventId & '/seats/' & $req.seatId & '/hold/' & $holdId %}",
        "Method": "DELETE",
        "Authentication": { "ConnectionArn": "__CONNECTION_ARN__" }
      },
      "Retry": [
        { "ErrorEquals": ["States.Http.StatusCode.404"], "MaxAttempts": 0 },
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "PurchaseRefunded" }],
      "Next": "PurchaseRefunded"
    },

    "EnqueueTicketIssuance": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Arguments": {
        "QueueUrl": "__QUEUE_URL__",
        "MessageBody": {
          "orderId": "{% $orderId %}",
          "eventId": "{% $req.eventId %}",
          "seatId": "{% $req.seatId %}",
          "customerRef": "{% $req.customerRef %}",
          "gatewayRef": "{% $payment.gatewayRef %}",
          "amountCents": "{% $req.amountCents %}"
        }
      },
      "Retry": [{
        "ErrorEquals": ["States.ALL"],
        "IntervalSeconds": 2,
        "MaxAttempts": 4,
        "BackoffRate": 2.0
      }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "PaidButNotIssued" }],
      "Next": "NotifyPurchaseConfirmed"
    },

    "NotifyPurchaseConfirmed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Arguments": {
        "TopicArn": "__TOPIC_ARN__",
        "Subject": "Ticket purchase confirmed",
        "Message": "{% $string({ 'orderId': $orderId, 'eventId': $req.eventId, 'seatId': $req.seatId, 'customerRef': $req.customerRef, 'email': $req.email, 'gatewayRef': $payment.gatewayRef, 'amountCents': $req.amountCents }) %}"
      },
      "Retry": [{
        "ErrorEquals": ["States.ALL"],
        "IntervalSeconds": 2,
        "MaxAttempts": 3,
        "BackoffRate": 2.0
      }],
      "Next": "Succeeded"
    },

    "Succeeded": {
      "Type": "Succeed",
      "Output": {
        "orderId": "{% $orderId %}",
        "seatId": "{% $req.seatId %}",
        "gatewayRef": "{% $payment.gatewayRef %}"
      }
    },

    "ReleaseSeat": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "ApiEndpoint": "{% $req.inventoryBaseUrl & '/events/' & $req.eventId & '/seats/' & $req.seatId & '/hold/' & $holdId %}",
        "Method": "DELETE",
        "Authentication": { "ConnectionArn": "__CONNECTION_ARN__" }
      },
      "Retry": [{
        "ErrorEquals": ["States.ALL"],
        "IntervalSeconds": 2,
        "MaxAttempts": 4,
        "BackoffRate": 2.0
      }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "CompensationFailed" }],
      "Next": "PaymentFailed"
    },

    "SeatUnavailable": {
      "Type": "Fail",
      "Error": "SeatUnavailable",
      "Cause": "The seat could not be held; nothing was reserved so there is nothing to compensate."
    },

    "PaymentFailed": {
      "Type": "Fail",
      "Error": "PaymentFailed",
      "Cause": "Payment was not captured. The seat hold has been released."
    },

    "CompensationFailed": {
      "Type": "Fail",
      "Error": "CompensationFailed",
      "Cause": "Payment failed AND the seat could not be released. The hold TTL and the cleanup Lambda are the backstop."
    },

    "PaidButNotConfirmed": {
      "Type": "Fail",
      "Error": "PaidButNotConfirmed",
      "Cause": "Money moved and the seat inventory never answered the confirm definitively (timeouts or 5xx after retries), so the seat may be SOLD to this order. Read the seat: SOLD under this holdId means resume at EnqueueTicketIssuance; anything else means POST /orders/{orderId}/refund. Never release the seat blind."
    },

    "PurchaseRefunded": {
      "Type": "Fail",
      "Error": "PurchaseRefunded",
      "Cause": "Payment was captured, the seat inventory definitively refused the confirm (the hold expired or was lost), and the payment has been refunded in full. The hold release that follows is best-effort; the TTL and the cleanup Lambda are its backstop."
    },

    "RefundFailed": {
      "Type": "Fail",
      "Error": "RefundFailed",
      "Cause": "Money moved, the seat is definitively not this order's, and the refund did not complete. The order is still PAID with a FAILED or PENDING refund row: retry with POST /orders/{orderId}/refund under a new idempotency key."
    },

    "PaidButNotIssued": {
      "Type": "Fail",
      "Error": "PaidButNotIssued",
      "Cause": "Money moved and the seat is SOLD, but the issuance message was not enqueued. Replay from this point; do not re-charge."
    }
  }
}
