#!/usr/bin/env bash
# Blocks a commit whose staged changes contain a secret or an identifier this repo keeps out
# of git (CLAUDE.md, "Secrets and identifiers"). Rules: .gitleaks.toml. When Terraform files
# are staged, it first checks they are `terraform fmt`-clean.
#
# Enable once per clone:   git config core.hooksPath .githooks
#
# Fails closed: if nothing can scan, the commit is refused rather than let through unscanned.
# A false positive is fixed in .gitleaks.toml (an allowlist entry), never with --no-verify.
set -euo pipefail

root=$(git rev-parse --show-toplevel)
image=ghcr.io/gitleaks/gitleaks:v8.30.1
args=(git --pre-commit --staged --redact --no-banner --config .gitleaks.toml .)

# Docker Desktop's context may be configured but not running; the system daemon still is.
if ! docker info >/dev/null 2>&1 && [ -S /var/run/docker.sock ]; then
  export DOCKER_HOST=unix:///var/run/docker.sock
fi

# 1. Terraform formatting (D2), only when Terraform files are staged. Same fail-closed rule.
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.(tf|tftest\.hcl)$'; then
  tf_version=$(cat "$root/.terraform-version")
  if command -v terraform >/dev/null 2>&1; then
    terraform fmt -check -recursive "$root/infra" >/dev/null || {
      echo "pre-commit: terraform fmt found unformatted files -- run: terraform fmt -recursive infra" >&2
      exit 1
    }
  elif docker info >/dev/null 2>&1; then
    docker run --rm --network none --user "$(id -u):$(id -g)" -v "$root/infra:/infra" \
      "hashicorp/terraform:$tf_version" fmt -check -recursive /infra >/dev/null || {
      echo "pre-commit: terraform fmt found unformatted files -- run: terraform fmt -recursive infra" >&2
      exit 1
    }
  else
    echo "pre-commit: cannot check Terraform formatting -- install terraform, or start Docker." >&2
    exit 1
  fi
fi

# 2. Secrets and identifiers.

if command -v gitleaks >/dev/null 2>&1; then
  cd "$root" && exec gitleaks "${args[@]}"
fi

if docker info >/dev/null 2>&1; then
  # Same uid as the repo's owner, or git inside the container refuses it as "dubious ownership".
  exec docker run --rm --network none --user "$(id -u):$(id -g)" -e HOME=/tmp \
    -v "$root:/repo" -w /repo "$image" "${args[@]}"
fi

echo "pre-commit: cannot scan for secrets -- install gitleaks, or start Docker." >&2
exit 1
